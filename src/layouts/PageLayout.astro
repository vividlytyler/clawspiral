---
import BaseLayout from './BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description?: string;
  image?: string;
}

const { title, description, image } = Astro.props;
---

<BaseLayout title={title} description={description} image={image}>
  <Header />
  <main class="flex-1 max-w-6xl mx-auto px-6 py-16 w-full">
    <slot />
  </main>
  <Footer />

  <!-- Back to top button -->
  <button
    id="back-to-top"
    aria-label="Scroll back to top"
    class="fixed bottom-6 right-6 w-11 h-11 rounded-xl bg-slate-800 border border-slate-600 text-slate-400 hover:bg-slate-700 hover:text-sky-400 hover:border-sky-500/50 hover:-translate-y-0.5 hover:shadow-lg hover:shadow-black/40 transition-all duration-200 opacity-0 translate-y-2 pointer-events-none z-50"
  >
    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mx-auto"><path d="m18 15-6-6-6 6"/></svg>
  </button>

  <script>
    const btn = document.getElementById('back-to-top');
    if (btn) {
      const onScroll = () => {
        const show = window.scrollY > 400;
        btn.style.opacity = show ? '1' : '0';
        btn.style.transform = show ? 'translateY(0)' : 'translateY(8px)';
        btn.style.pointerEvents = show ? 'auto' : 'none';
      };
      window.addEventListener('scroll', onScroll, { passive: true });
      btn.addEventListener('click', () => window.scrollTo({ top: 0, behavior: 'smooth' }));
      onScroll();
    }
  </script>
</BaseLayout>
